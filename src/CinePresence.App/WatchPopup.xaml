<Window x:Class="CinePresence.App.WatchPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now watching · CinePresence" Width="356" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
  <Border x:Name="PopupSurface" Background="#191D27" BorderBrush="#514666" BorderThickness="1" CornerRadius="12" Padding="16" RenderTransformOrigin="0.5,1">
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="PopupScale"/><TranslateTransform x:Name="PopupOffset"/></TransformGroup></Border.RenderTransform>
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="▶" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,8,0"/>
          <TextBlock Text="CINEPRESENCE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Button x:Name="DismissButton" Grid.Column="1" Content="×" Padding="6,0" FontSize="16" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Dismiss watching popup"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Height="90" Width="60" CornerRadius="7" Background="#2B263E" VerticalAlignment="Top">
          <Grid><TextBlock Text="▶" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="ShowArtwork" Width="60" Height="90" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Show poster">
              <Image.Clip><RectangleGeometry Rect="0,0,60,90" RadiusX="7" RadiusY="7"/></Image.Clip>
            </Image>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="Watching" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,0,3"/>
          <TextBlock x:Name="WatchingTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
          <TextBlock x:Name="WatchingDetails" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Not what's playing?" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="ChangeMatchButton" Grid.Column="1" Content="Change match" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="12,7" AutomationProperties.Name="Change the detected movie or show"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
