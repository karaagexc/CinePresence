{
  "manifest_version": 3,
  "name": "CinePresence Companion",
  "version": "0.2.4",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "description": "Send movie and series playback metadata to your local CinePresence app. Music, social and general video platforms are excluded.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "background": { "service_worker": "dist/worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "CinePresence", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["dist/metadata.js", "dist/content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_origin_as_fallback": true
  }]
}
