{
  "manifest_version": 3,
  "name": "CinePresence Companion",
  "version": "0.2.0",
  "description": "Send movie and series playback metadata to your local CinePresence app. Social and general video platforms are excluded.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "CinePresence" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["metadata.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_origin_as_fallback": true
  }]
}
