{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmitOnError": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
